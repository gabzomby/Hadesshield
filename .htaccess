# Page d'erreur personnalisée sous Apache.
# Si le site est installé dans un sous-dossier, adapter le chemin (ex. /monsite/404.php).
ErrorDocument 404 /404.php

RewriteEngine On

# Adresse unique pour Google : hadesshield.com -> https://www.hadesshield.com
# (sauf /.well-known/, utilisé par OVH pour renouveler le certificat HTTPS)
RewriteCond %{HTTP_HOST} ^hadesshield\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://www.hadesshield.com/$1 [R=301,L]

# Redirige tout le trafic http:// vers https:// (certificat Let's Encrypt OVH).
RewriteCond %{SERVER_PORT} 80
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
