# Page d'erreur personnalisée sous Apache.
# Si le site est installé dans un sous-dossier, adapter le chemin (ex. /monsite/404.php).
ErrorDocument 404 /404.php

RewriteEngine On

# Accès réservé au proxy HadesShield, quelle que soit son IP (elle change à chaque redémarrage) :
# toute requête qui arrive chez OVH sans l'en-tête X-HadesShield-Proxy est refusée.
# Ce premier filtre ne regarde que la présence de l'en-tête ; la valeur exacte du secret
# (rangé dans data/, hors GitHub) est vérifiée par PHP sur chaque page (includes/config.php).
# Restent ouverts : /.well-known/acme-challenge/ (certificat HTTPS) et /api/ (protégée par sa clé d'API).
# Retour arrière rapide : remplacer ce fichier par .htaccess.avant-blocage-ovh (copie d'avant).
# (REDIRECT_STATUS vide = requête d'origine : la page d'erreur 404.php, appelée en interne, n'est pas bloquée)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTP:X-HadesShield-Proxy} ^$
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ - [F]

# Adresse unique pour Google : hadesshield.com -> https://www.hadesshield.com
# (sauf /.well-known/, utilisé par OVH pour renouveler le certificat HTTPS)
RewriteCond %{HTTP_HOST} ^hadesshield\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*)$ https://www.hadesshield.com/$1 [R=301,L]

# Redirige tout le trafic http:// vers https:// (certificat Let's Encrypt OVH).
RewriteCond %{SERVER_PORT} 80
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Derrière Cloudflare, OVH est toujours contacté en https : le protocole du visiteur
# arrive dans l'en-tête CF-Visitor, {"scheme":"http"} ou {"scheme":"https"}
# (X-Forwarded-Proto est réécrit par le relais d'OVH, on ne peut pas s'y fier).
RewriteCond %{HTTP:CF-Visitor} http[^s]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
